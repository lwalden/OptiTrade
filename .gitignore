# ==============================================================================
# Core .gitignore -- secrets, IDE files, OS artifacts
# ==============================================================================

# Secrets and environment variables -- NEVER commit these
.env
.env.local
.env.*.local
*.env
.envrc
.secrets
secrets/
*.pem
*.key
*.p12
*.pfx
local.settings.json

# IDE and editor artifacts
.idea/
.vscode/
*.swp
*.swo
*~
.vs/
*.user
*.suo

# OS generated
.DS_Store
._*
Thumbs.db
desktop.ini

# Logs
*.log
logs/

# Temporary files
tmp/
temp/
*.tmp
*.bak

# Claude Code auto memory (project-specific, not for version control)
# Uncomment if you use Claude Code's auto memory feature:
# .claude/memory/

# ==============================================================================
# Python
# ==============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
ENV/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
build/
*.egg
pip-wheel-metadata/
.tox/
.coverage
htmlcov/
.hypothesis/

# ==============================================================================
# Trading / IB specific
# ==============================================================================
# IB Gateway logs and configs that shouldn't be committed
jts.ini
ibgateway/
TWS/

# Market data caches
data/cache/
*.parquet
*.feather
