{
  "permissions": {
    "allow": [
      "Bash(uv pip install:*)",
      "Bash(uv run pytest:*)",
      "Bash(uv run python:*)",
      "Bash(gh pr view:*)",
      "Bash(git restore:*)",
      "Bash(ls:*)"
    ],
    "deny": [
      "Bash(rm -rf /:*)",
      "Bash(rm -rf ~:*)",
      "Bash(rm -rf $HOME:*)",
      "Bash(rm -rf C::*)",
      "Bash(rm -rf .:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard origin:*)",
      "Bash(git clean -fd:*)",
      "Bash(chmod -R 777:*)"
    ],
    "additionalDirectories": [
      "d:\\Source\\OptiTrade\\optimind\\config",
      "d:\\Source\\OptiTrade\\optimind\\core",
      "d:\\Source\\OptiTrade\\optimind\\broker\\ibkr",
      "d:\\Source\\OptiTrade\\optimind\\broker\\tradier",
      "d:\\Source\\OptiTrade\\optimind\\data",
      "d:\\Source\\OptiTrade\\optimind\\strategies",
      "d:\\Source\\OptiTrade\\optimind\\risk",
      "d:\\Source\\OptiTrade\\optimind\\execution",
      "d:\\Source\\OptiTrade\\optimind\\monitor",
      "d:\\Source\\OptiTrade\\optimind\\ai\\prompts",
      "d:\\Source\\OptiTrade\\optimind\\mcp",
      "d:\\Source\\OptiTrade\\optimind\\dashboard\\pages",
      "d:\\Source\\OptiTrade\\optimind\\cli",
      "d:\\Source\\OptiTrade\\tests",
      "d:\\Source\\OptiTrade\\scripts",
      "d:\\Source\\OptiTrade\\backtests",
      "d:\\Source\\OptiTrade\\reports"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/session-end-timestamp.js",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/session-end-commit.js",
            "timeout": 30
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/pre-compact-save.js",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/session-start-context.js",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
