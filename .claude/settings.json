{
  "statusLine": {
    "type": "command",
    "command": "bash .claude/scripts/context-monitor.sh"
  },
  "permissions": {
    "allow": [
      "Bash(uv pip install:*)",
      "Bash(uv run pytest:*)",
      "Bash(uv run python:*)",
      "Bash(gh pr view:*)",
      "Bash(git restore:*)",
      "Bash(ls:*)",
      "Bash(wc:*)",
      "Bash(python -m pytest:*)",
      "Bash(.venv/Scripts/python.exe -m pytest tests/ -v)",
      "Read(//c/Users/lwald/AppData/Roaming/Claude/**)",
      "Read(//c/Users/lwald/**)",
      "Bash(python -m json.tool:*)"
    ],
    "deny": [
      "Bash(rm -rf /:*)",
      "Bash(rm -rf ~:*)",
      "Bash(rm -rf $HOME:*)",
      "Bash(rm -rf C::*)",
      "Bash(rm -rf .:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard origin:*)",
      "Bash(git clean -fd:*)",
      "Bash(chmod -R 777:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/scripts/context-cycle-hook.sh"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/scripts/sprint-phase-guard.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/scripts/correction-capture-hook.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/scripts/sprint-stop-guard.sh"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/scripts/session-end-cycle.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/scripts/hlpm-ping.sh session_end"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/scripts/session-start-continuation.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/scripts/hlpm-ping.sh session_start"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/scripts/session-start-hook.sh"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/scripts/stop-failure-hook.sh"
          }
        ]
      }
    ]
  }
}
