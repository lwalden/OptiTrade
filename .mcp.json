{
  "mcpServers": {
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    },
    "dbhub": {
      "type": "stdio",
      "command": "cmd",
      "args": ["/c", "npx", "-y", "@bytebase/dbhub"],
      "env": {
        "DATABASE_URL": "sqlite:///./data/optimind.db"
      }
    }
  }
}
